# SOCIAL-UNSCH — variables de la aplicación web (apps/web). Valores ficticios.
# Copiar a apps/web/.env.local para desarrollo. Next.js solo expone al navegador las variables
# con prefijo NEXT_PUBLIC_; aquí no debe haber ningún secreto.

# URL base de la API. Se incrusta en el código del navegador durante `next build`.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
