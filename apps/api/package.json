{
  "name": "@social-unsch/api",
  "version": "1.0.0",
  "private": true,
  "description": "API Express de SOCIAL-UNSCH (una única aplicación desplegable)",
  "main": "dist/server.js",
  "engines": {
    "node": "^20.14.0 || ^22.11.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --project tsconfig.json --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.jest.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:real": "jest --config jest.real.config.ts --runInBand",
    "db:migrate": "ts-node --project tsconfig.json src/database/migrations/run_migrate.ts",
    "db:catalogs": "ts-node --project tsconfig.json src/database/migrations/run_catalogs.ts",
    "db:seed:demo": "ts-node --project tsconfig.json src/database/migrations/run_demo_seed.ts",
    "db:migrate:status": "ts-node --project tsconfig.json src/database/migrations/run_status.ts",
    "db:migrate:all": "ts-node --project tsconfig.json src/database/migrations/migrate_all.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
