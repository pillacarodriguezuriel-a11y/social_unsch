# SOCIAL-UNSCH — Servicio independiente de Campus Radar.
# Copiar a apps/radar/.env y completar. TODOS los valores son ficticios.
# Detalle en docs/migracion/INVENTARIO_CONFIGURACION.md

# --- Puerto y Entorno ---
# En Render, PORT se inyecta automáticamente. En local usamos 4001 por defecto.
PORT=4001
NODE_ENV=development
SERVICE_NAME=social-unsch-radar

# --- CORS ---
# Orígenes permitidos, separados por comas sin espacios.
# En desarrollo: API principal (3000) y Web (3001).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Redis (Almacén temporal de votos y afluencia) ---
# Local (docker-compose o redis local):
REDIS_URL=redis://127.0.0.1:6379
# Upstash / Redis gestionado en producción (TLS obligatorio, esquema rediss://):
# REDIS_URL=rediss://default:<CONTRASENA>@<HOST_UPSTASH>:6379

# --- Autenticación (JWT RS256 - Solo Clave Pública) ---
# Radar solo verifica firmas; NO posee la clave privada.
# PEM en una sola línea con saltos escapados como \n.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<CLAVE_PUBLICA_FICTICIA>\n-----END PUBLIC KEY-----\n"
