{
  "name": "@social-unsch/radar",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio independiente de Campus Radar para SOCIAL-UNSCH",
  "main": "dist/server.js",
  "engines": {
    "node": "^20.14.0 || ^22.11.0 || ^24.0.0"
  },
  "scripts": {
    "build": "npm run build --prefix ../../packages/contracts && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build --prefix ../../packages/contracts && ts-node-dev --project tsconfig.json --respawn --transpile-only src/server.ts",
    "typecheck": "npm run build --prefix ../../packages/contracts && tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.jest.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@social-unsch/contracts": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
