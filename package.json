{
  "name": "social-unsch-backend",
  "version": "1.0.0",
  "description": "Backend de la red social académica SOCIAL-UNSCH",
  "main": "dist/server.js",
  "engines": {
    "node": "^20.14.0 || ^22.11.0 || ^24.0.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.backend.json",
    "build:frontend": "next build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --project tsconfig.backend.json --respawn --transpile-only src/server.ts",
    "dev:backend": "ts-node-dev --project tsconfig.backend.json --respawn --transpile-only src/server.ts",
    "dev:frontend": "next dev -p 3001",
    "dev:all": "node scripts/dev-all.js",
    "db:migrate": "ts-node --project tsconfig.backend.json src/database/migrations/run_migrate.ts",
    "db:catalogs": "ts-node --project tsconfig.backend.json src/database/migrations/run_catalogs.ts",
    "db:seed:demo": "ts-node --project tsconfig.backend.json src/database/migrations/run_demo_seed.ts",
    "db:migrate:status": "ts-node --project tsconfig.backend.json src/database/migrations/run_status.ts",
    "db:migrate:all": "ts-node --project tsconfig.backend.json src/database/migrations/migrate_all.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:real": "jest --config jest.real.config.ts --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "next": "^14.2.4",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.5.2",
    "jest": "^30.4.2",
    "postcss": "^8.5.16",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
