{
  "name": "social-unsch",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de SOCIAL-UNSCH: aplicación web (apps/web) y API (apps/api)",
  "engines": {
    "node": "^20.14.0 || ^22.11.0 || ^24.0.0",
    "npm": ">=10.8.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @social-unsch/api",
    "build:api": "npm run build -w @social-unsch/api",
    "build:frontend": "npm run build -w @social-unsch/web",
    "build:all": "npm run build:api && npm run build:frontend",
    "start": "npm run start -w @social-unsch/api",
    "dev": "npm run dev -w @social-unsch/api",
    "dev:backend": "npm run dev -w @social-unsch/api",
    "dev:frontend": "npm run dev -w @social-unsch/web",
    "dev:all": "node scripts/dev-all.js",
    "typecheck": "npm run typecheck -w @social-unsch/api && npm run typecheck -w @social-unsch/web",
    "test": "npm test -w @social-unsch/api && npm test -w @social-unsch/web",
    "test:watch": "npm run test:watch -w @social-unsch/api",
    "test:coverage": "npm run test:coverage -w @social-unsch/api",
    "test:real": "npm run test:real -w @social-unsch/api",
    "test:web": "npm test -w @social-unsch/web",
    "db:migrate": "npm run db:migrate -w @social-unsch/api",
    "db:catalogs": "npm run db:catalogs -w @social-unsch/api",
    "db:seed:demo": "npm run db:seed:demo -w @social-unsch/api --",
    "db:migrate:status": "npm run db:migrate:status -w @social-unsch/api",
    "db:migrate:all": "npm run db:migrate:all -w @social-unsch/api"
  }
}
